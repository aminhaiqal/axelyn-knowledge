# PostgreSQL database owned by Axelyn Knowledge. Never point this at axelyn-signal's database.
DATABASE_URL=postgresql://axelyn_knowledge:axelyn_knowledge@127.0.0.1:5432/axelyn_knowledge
DATABASE_POOL_SIZE=10
DEFAULT_WORKSPACE=axelyn

# JSON array. Replace the placeholder; use a different token for every calling service.
SERVICE_TOKENS=[{"id":"axelyn-signal-local","secret":"replace-with-at-least-32-random-characters","workspaces":["axelyn"]}]

# Local operator identity. ALLOW_DEV_OPERATOR is ignored when NODE_ENV=production.
ALLOW_DEV_OPERATOR=true
DEV_OPERATOR_EMAIL=operator@localhost

# Optional cost-aware OpenRouter extraction cascade. One key can access every model in the chain.
# Models run left-to-right; later models are used only when an earlier result fails validation.
EXTRACTION_BASE_URL=https://openrouter.ai/api/v1
EXTRACTION_API_KEY=
EXTRACTION_MODELS=google/gemini-2.5-flash-lite,openai/gpt-5-mini,anthropic/claude-sonnet-4.6

# Encrypts workspace-managed provider keys. Generate with: openssl rand -base64 32
# Production deployment generates this automatically when it is empty or absent.
CREDENTIAL_ENCRYPTION_KEY=

# Optional OpenAI-compatible embeddings. Retrieval falls back to lexical + graph when unset.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
